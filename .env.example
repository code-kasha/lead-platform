ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://your-database-user:your-database-password@localhost:5432/your-database-name

DEBUG=True

DJANGO_ENV=development

SECRET_KEY=your-secret-key

VITE_API_URL=http://127.0.0.1:8000/api

# Production only (DJANGO_ENV=production); startup fails if either is empty
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com

# Production only: HTTP Strict Transport Security (defaults shown). Raise
# HSTS_SECONDS in steps once HTTPS is stable; enable the other two only if
# every subdomain serves HTTPS.
HSTS_SECONDS=3600
HSTS_INCLUDE_SUBDOMAINS=False
HSTS_PRELOAD=False
